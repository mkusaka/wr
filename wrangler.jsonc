{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wr",
      "database_id": "e905dfb1-7588-43e0-a0cd-d938cd2f660c",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "mkusaka.cloudflareaccess.com",
    "ACCESS_AUD": "77adda8348684685d253194212bddb0edbcc7f5166f2d3f9062f464e062bd5ac",
  },
}
