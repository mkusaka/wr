{
  "name": "wr-next",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "bin": {
    "wr-next": "bin/wr-next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bun scripts/lint.mjs",
    "test": "bun run build && bun test --timeout 30000 dist/test",
    "dev": "bun run build && bun dist/src/cli/main.js serve",
    "demo": "bun run build && bun dist/examples/demo.js",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run demo && bun run test:integration",
    "format": "bun scripts/format.mjs",
    "format:check": "bun scripts/format.mjs --check",
    "test:integration": "bun run build && bun dist/examples/integration-demo.js",
    "test:live": "bun run build && bun scripts/live.mjs",
    "test:workerd": "bun scripts/workerd-smoke.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "typescript": "5.8.3"
  }
}
