{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun", "@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./web/*"] },
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "worker", "web", "test-worker", "test-unit", "test-web", "*.ts"]
}
