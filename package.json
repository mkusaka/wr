{
  "name": "wr",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "wr": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "compile": "bun build --compile --minify --sourcemap src/cli.ts --outfile dist/wr",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.14"
}
