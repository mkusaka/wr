{
  "name": "wr",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "wr": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "compile": "bun build --compile --minify --sourcemap src/cli.ts --outfile dist/wr",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate --config=drizzle.remote.config.ts",
    "dev": "vite",
    "build": "vite build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint . --deny-warnings",
    "test": "bun test ./test-unit && vitest run && vitest run --config vitest.web.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/inertia": "^0.7.0",
    "@inertiajs/react": "^3.6.1",
    "@optique/core": "^1.2.1",
    "@optique/run": "^1.2.1",
    "@optique/valibot": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "ink": "^7.1.1",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "nuqs": "^2.9.5",
    "oauth4webapi": "^3.8.7",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-devtools-core": "^7.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vite-ssr-components": "^0.6.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "knip": "6.29.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "packageManager": "bun@1.3.14",
  "knip": {
    "entry": [
      "web/main.tsx",
      "test-worker/*.test.ts",
      "test-unit/*.test.ts"
    ],
    "project": [
      "src/**/*.ts",
      "worker/**/*.ts",
      "web/**/*.ts",
      "web/**/*.tsx",
      "test-worker/**/*.ts",
      "test-unit/**/*.ts"
    ],
    "ignoreDependencies": [
      "cloudflare",
      "@fontsource-variable/geist",
      "shadcn",
      "tailwindcss",
      "tw-animate-css"
    ]
  }
}
